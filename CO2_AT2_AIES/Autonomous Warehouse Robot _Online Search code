# Simple Online Search Robot

grid = [
    ['S', '.', '.', '#', '.'],
    ['.', '.', '.', '#', '.'],
    ['.', '#', '.', '.', '.'],
    ['.', '#', '#', '.', '.'],
    ['.', '.', '.', '.', 'G']
]

start = (0, 0)
goal = (4, 4)

def distance(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])

current = start
visited = set()

while current != goal:

    visited.add(current)

    neighbours = [
        (current[0] - 1, current[1]),
        (current[0] + 1, current[1]),
        (current[0], current[1] - 1),
        (current[0], current[1] + 1)
    ]

    possible = []

    for r, c in neighbours:
        if 0 <= r < len(grid) and 0 <= c < len(grid[0]):
            if grid[r][c] != '#':
                possible.append((r, c))

    possible = [x for x in possible if x not in visited]

    if not possible:
        print("Robot has reached a dead end.")
        break

    next_cell = min(
        possible,
        key=lambda x: distance(x, goal)
    )

    print("Robot moves from", current, "to", next_cell)

    current = next_cell

if current == goal:
    print("Target reached!")
