# Alpha-Beta Pruning

def alphabeta(depth, node, alpha, beta, isMax):
    if depth == 3:          # Leaf node
        return values[node]

    if isMax:
        best = -1000
        for i in range(2):
            val = alphabeta(depth + 1, node * 2 + i, alpha, beta, False)
            best = max(best, val)
            alpha = max(alpha, best)
            if beta <= alpha:
                break       # Prune
        return best
    else:
        best = 1000
        for i in range(2):
            val = alphabeta(depth + 1, node * 2 + i, alpha, beta, True)
            best = min(best, val)
            beta = min(beta, best)
            if beta <= alpha:
                break       # Prune
        return best

# Leaf node values
values = [3, 5, 2, 9, 12, 5, 23, 23]

result = alphabeta(0, 0, -1000, 1000, True)

print("Optimal value is:", result)
