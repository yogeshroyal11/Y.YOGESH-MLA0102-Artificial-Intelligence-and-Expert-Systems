# Smart Loan Approval using Decision Tree
# Course: Artificial Intelligence and Expert Systems
# AI Technique: Decision Tree
# Attribute Selection Measure: Gini Index

import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

# ---------------------------------------------------------
# 1. CREATE DATASET
# ---------------------------------------------------------

data = {
    "Income": [
        25000, 30000, 45000, 50000, 60000,
        70000, 80000, 35000, 40000, 90000,
        55000, 28000, 75000, 65000, 32000,
        85000, 48000, 52000, 38000, 95000
    ],

    "CreditScore": [
        580, 600, 650, 700, 720,
        750, 780, 620, 640, 800,
        710, 590, 760, 730, 610,
        790, 680, 705, 630, 820
    ],

    "EmploymentStatus": [
        "Unemployed", "Self", "Employed", "Employed", "Employed",
        "Employed", "Employed", "Self", "Employed", "Employed",
        "Employed", "Unemployed", "Employed", "Employed", "Self",
        "Employed", "Employed", "Employed", "Unemployed", "Employed"
    ],

    "LoanAmount": [
        200000, 150000, 250000, 300000, 350000,
        400000, 450000, 180000, 220000, 500000,
        280000, 160000, 420000, 380000, 200000,
        480000, 270000, 310000, 190000, 550000
    ],

    "RepaymentHistory": [
        "Poor", "Poor", "Good", "Good", "Good",
        "Excellent", "Excellent", "Average", "Good", "Excellent",
        "Good", "Poor", "Excellent", "Good", "Average",
        "Excellent", "Good", "Good", "Poor", "Excellent"
    ],

    "LoanApproved": [
        "No", "No", "Yes", "Yes", "Yes",
        "Yes", "Yes", "No", "Yes", "Yes",
        "Yes", "No", "Yes", "Yes", "No",
        "Yes", "Yes", "Yes", "No", "Yes"
    ]
}

df = pd.DataFrame(data)

print("\n===== DATASET =====")
print(df)

# ---------------------------------------------------------
# 2. DATA PREPROCESSING
# ---------------------------------------------------------

# Encode categorical columns
encoder = LabelEncoder()

df["EmploymentStatus"] = encoder.fit_transform(
    df["EmploymentStatus"]
)

df["RepaymentHistory"] = encoder.fit_transform(
    df["RepaymentHistory"]
)

df["LoanApproved"] = encoder.fit_transform(
    df["LoanApproved"]
)

print("\n===== PREPROCESSED DATA =====")
print(df)

# ---------------------------------------------------------
# 3. DEFINE FEATURES AND TARGET
# ---------------------------------------------------------

X = df.drop("LoanApproved", axis=1)
y = df["LoanApproved"]

# ---------------------------------------------------------
# 4. TRAIN-TEST SPLIT
# ---------------------------------------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

print("\nTraining samples:", len(X_train))
print("Testing samples :", len(X_test))

# ---------------------------------------------------------
# 5. CREATE DECISION TREE MODEL
# ---------------------------------------------------------

model = DecisionTreeClassifier(
    criterion="gini",
    max_depth=4,
    random_state=42
)

# Train model
model.fit(X_train, y_train)

# ---------------------------------------------------------
# 6. MAKE PREDICTIONS
# ---------------------------------------------------------

y_pred = model.predict(X_test)

# ---------------------------------------------------------
# 7. PERFORMANCE EVALUATION
# ---------------------------------------------------------

accuracy = accuracy_score(y_test, y_pred)
precision = precision_score(y_test, y_pred, zero_division=0)
recall = recall_score(y_test, y_pred, zero_division=0)
f1 = f1_score(y_test, y_pred, zero_division=0)

print("\n===== MODEL PERFORMANCE =====")
print("Accuracy  :", round(accuracy, 2))
print("Precision :", round(precision, 2))
print("Recall    :", round(recall, 2))
print("F1 Score  :", round(f1, 2))

print("\n===== CONFUSION MATRIX =====")
print(confusion_matrix(y_test, y_pred))

print("\n===== CLASSIFICATION REPORT =====")
print(
    classification_report(
        y_test,
        y_pred,
        target_names=["Not Approved", "Approved"],
        zero_division=0
    )
)

# ---------------------------------------------------------
# 8. DISPLAY DECISION TREE
# ---------------------------------------------------------

plt.figure(figsize=(18, 10))

plot_tree(
    model,
    feature_names=X.columns,
    class_names=["Not Approved", "Approved"],
    filled=True,
    rounded=True
)

plt.title("Decision Tree - Smart Loan Approval")
plt.savefig("decision_tree.png")
plt.show()

# ---------------------------------------------------------
# 9. TEST WITH A NEW CUSTOMER
# ---------------------------------------------------------

# New customer details
new_customer = pd.DataFrame({
    "Income": [65000],
    "CreditScore": [740],
    "EmploymentStatus": [
        encoder.transform(["Employed"])[0]
    ],
    "LoanAmount": [300000],
    "RepaymentHistory": [
        encoder.transform(["Good"])[0]
    ]
})

prediction = model.predict(new_customer)

if prediction[0] == 1:
    print("\n===== NEW CUSTOMER PREDICTION =====")
    print("Loan Status: APPROVED")
else:
    print("\n===== NEW CUSTOMER PREDICTION =====")
    print("Loan Status: NOT APPROVED")
