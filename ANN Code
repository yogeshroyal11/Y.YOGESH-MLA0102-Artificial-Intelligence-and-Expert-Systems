from sklearn.neural_network import MLPClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

# Medical data: [Age, Blood Pressure, Sugar, Cholesterol]
X = [
    [25, 120, 90, 180],
    [30, 125, 95, 190],
    [45, 145, 160, 240],
    [50, 150, 170, 250],
    [35, 130, 100, 200],
    [60, 160, 180, 270],
    [28, 118, 85, 175],
    [55, 155, 165, 260]
]

# 0 = No Disease, 1 = Disease
y = [0, 0, 1, 1, 0, 1, 0, 1]

# Split data
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

# Create and train neural network
model = MLPClassifier(hidden_layer_sizes=(5,), max_iter=2000, random_state=42)
model.fit(X_train, y_train)

# Test the model
prediction = model.predict(X_test)

print("Actual:", y_test)
print("Predicted:", prediction)
print("Accuracy:", accuracy_score(y_test, prediction))

# New patient
patient = [[48, 148, 155, 245]]
result = model.predict(patient)

if result[0] == 1:
    print("Prediction: Patient may have the disease")
else:
    print("Prediction: Patient may not have the disease")
